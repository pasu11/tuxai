{
  "manifest_version": 3,
  "name": "Tuxai",
  "version": "1.0.0",
  "description": "An open-source AI sidebar that connects to your local LLM server or a cloud API and lets you run selected text through your tools.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tuxai@local.dev",
      "strict_min_version": "115.0"
    }
  },
  "action": {
    "default_title": "Tuxai",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "Tuxai",
    "default_panel": "sidebar/sidebar.html"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/quickselect.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
