{
  "name": "tuxai",
  "version": "1.2.1",
  "private": true,
  "license": "Unlicense",
  "type": "module",
  "description": "Clean source-based Chrome/Vivaldi/Firefox extension: TuxAI (local server + cloud chat).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --chrome",
    "build:firefox": "node scripts/build.mjs --firefox",
    "dev:firefox": "bash scripts/run-firefox.sh",
    "test:firefox": "node scripts/test-firefox.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "package:only": "node scripts/package.mjs"
  }
}
