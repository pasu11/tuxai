#!/bin/bash
# Git credential helper for TuxAI.
# Supplies a GitHub token from $GITHUB_TOKEN, or from the gitignored .env file,
# so git can push/pull without storing the token in .git/config or prompting.
#
# Register it (once per clone) with:
#   git config --local credential.helper "$PWD/scripts/git-credential-tuxai"

root="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$root" ] || root="$(cd "$(dirname "$0")/.." && pwd)"

if [ -z "${GITHUB_TOKEN:-}" ] && [ -f "$root/.env" ]; then
	set -a
	. "$root/.env"
	set +a
fi

# Drain the credential request from stdin (git credential protocol).
cat >/dev/null

[ -n "${GITHUB_TOKEN:-}" ] || exit 0
echo "username=x-access-token"
echo "password=$GITHUB_TOKEN"
